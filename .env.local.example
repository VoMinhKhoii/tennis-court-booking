# Copy to .env.local and fill in values from your Supabase project settings.
# .env.local is gitignored and must never be committed.

# Public — safe to expose to the browser (used by anon/browser & server clients).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — full-access service-role key. NEVER prefix with NEXT_PUBLIC_.
# Not used for routine owner actions (those use the owner's RLS session).
SUPABASE_SERVICE_ROLE_KEY=
